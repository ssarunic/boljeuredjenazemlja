# Cadastral API Configuration
# Copy this file to .env and configure as needed

# ⚠️ DEMO PROJECT - the defaults and every example use the included mock server.
#
# Before pointing the client at any other server, including the Croatian
# government systems, verify that you have the rights to use that server and
# its data (terms of service, data protection: real cadastral data is personal
# data). You do so at your own risk. See docs/legal.md.

# API Base URL
# Default: http://localhost:8000 (mock server - use this for testing/learning)
# Another server (at your own risk, after verifying your rights):
#   https://oss.uredjenazemlja.hr/oss/public
CADASTRAL_API_BASE_URL=http://localhost:8000

# What to do when the server sends a field no model declares (kept in
# source_fields either way): warn (default, logged once per field), ignore, error
# CADASTRAL_API_UNKNOWN_FIELDS=warn

# API Client Configuration
# CADASTRAL_API_TIMEOUT=10.0   # a whole LR unit or parcel record is waited for up to 120 s regardless
# CADASTRAL_API_RATE_LIMIT=0.75

# Spatial-plan building areas (get-zoning): WFS endpoint(s), comma-separated,
# tried in order. Default: <CADASTRAL_API_BASE_URL>/planning/wfs (the mock server).
# The Ministry's mirrors (at your own risk, after verifying your rights):
#   https://gis4.mgipu.hr/srv1/GradjPodrucje_MGIPU_Public/wfs,https://gis3.mgipu.hr/srv1/GradjPodrucje_MGIPU_Public/wfs
# CADASTRAL_PLANNING_WFS_URLS=http://localhost:8000/planning/wfs

# Language Configuration
# Supported: hr, en
# CADASTRAL_LANG=hr
